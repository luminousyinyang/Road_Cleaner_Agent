# Mirrors .gcloudignore. Keeps a local `docker build` honest about what the
# image actually needs, so it does not silently differ from the Cloud Build one.

.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Anchored, and negated, for the same reason as .gcloudignore -- see the long
# comment there. Docker's matcher and gitignore's do NOT agree about what a bare
# `data/` means, and this file claims to mirror that one, so the safe form is
# the one that reads the same under both.
/data/
/design_artifacts/
!src/road_cleaner/adapters/geo/data/

.env
