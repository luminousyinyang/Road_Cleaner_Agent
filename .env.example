# ============================================================================
# Road Cleaner configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and edit. Every value below is already the default, so an
# empty .env runs the full pipeline locally with no credentials at all.
#
#   cp .env.example .env
#   make setup && make demo
#
# Nothing in this file is secret in local mode. Once you add real API keys,
# .env is gitignored -- keep it that way, and use Secret Manager in production.
# ============================================================================


# --- Core -------------------------------------------------------------------

# local = fixtures, SQLite, in-memory bus, scripted vision. No credentials.
# cloud = 511 APIs, Firestore, GCS, Pub/Sub, Gemini on Vertex AI.
# Individual settings below override whichever mode you pick.
ROAD_CLEANER_MODE=local

# The anti-spam master switch. While true, reports are fully composed and
# stored but never actually sent to an agency. Turning this off is not enough
# on its own -- filing for real also needs `road-cleaner file --confirm`.
# Leave it true unless you are deliberately filing a real, human-reviewed report.
DRY_RUN=true

LOG_LEVEL=INFO
DATA_DIR=./data


# --- Vision and agent reasoning ---------------------------------------------

# false -> deterministic scripted reasoning, runs with no key.
# true  -> real Google ADK agents driving Gemini. Needs the Vertex settings below.
USE_ADK=false

# auto | scripted | gemini   (auto follows ROAD_CLEANER_MODE)
VISION_PROVIDER=auto

# NOTE: verify this against the current model list before enabling Gemini.
# The PRD was written against "Gemini 3.5 Flash"; set whatever Flash model is
# current in your project. This is config, not code -- nothing else changes.
GEMINI_MODEL=gemini-2.5-flash

# The cheap first-pass filter: one yes/no question per frame, so the expensive
# model only sees frames that already look anomalous.
GEMMA_PREFILTER_ENABLED=false
GEMMA_MODEL=gemma-3-4b-it

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Only used when GOOGLE_GENAI_USE_VERTEXAI=false (Gemini Developer API instead).
GOOGLE_API_KEY=


# --- Camera sources ---------------------------------------------------------

# auto | fixture | vendor511
# fixture   -> simulated cameras rendering synthetic road scenes
# vendor511 -> the real state DOT APIs (needs the keys below)
CAMERA_SOURCE=auto

# GA, FL and NC all run the same vendor platform:
#   https://<host>/api/v2/get/<resource>?key=<KEY>&format=json
# Each state issues its own free developer key. Register per state:
#   GA -> https://511ga.org  (account, then request a developer key)
#   FL -> https://fl511.com
#   NC -> https://drivenc.gov
# Approval can take days, so request them early.
GA_511_BASE_URL=https://511ga.org
FL_511_BASE_URL=https://fl511.com
NC_511_BASE_URL=https://www.drivenc.gov
GA_511_API_KEY=
FL_511_API_KEY=
NC_511_API_KEY=

# The published throttle on that platform is 10 calls per 60 seconds per key.
# We stay under it client-side rather than relying on being told to back off.
STATE_API_RATE_LIMIT=10
STATE_API_RATE_WINDOW_SECONDS=60


# --- Storage ----------------------------------------------------------------

# auto | sqlite | firestore
REPOSITORY=auto
SQLITE_PATH=./data/road_cleaner.db
FIRESTORE_DATABASE=(default)

# auto | local | gcs        -- where evidence frames live
BLOB_STORE=auto
BLOB_LOCAL_PATH=./data/frames
GCS_BUCKET=


# --- Event bus --------------------------------------------------------------

# auto | memory | pubsub
EVENT_BUS=auto
PUBSUB_TOPIC_FRAMES=frame-captured
PUBSUB_TOPIC_HAZARDS=hazard-confirmed
PUBSUB_TOPIC_DLQ=road-cleaner-dlq


# --- Filing -----------------------------------------------------------------

# auto | dry_run | open311 | email
# Defaults to dry_run in BOTH modes. Going live is always deliberate.
FILING_CHANNEL=auto

# Where dry-run reports get written instead of being sent.
FILING_SANDBOX_INBOX=./data/outbox
FILING_FROM_ADDRESS=road-cleaner@example.invalid

OPEN311_ENDPOINT=
OPEN311_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# --- Confidence gate --------------------------------------------------------
# This is the false-positive defense. It would rather miss a hazard than send
# an agency somebody after a shadow. Loosen these and you will file garbage.

# Below this, a detection is discarded outright.
GATE_MIN_CONFIDENCE=0.55
# A second sighting has to clear this to count as corroboration.
GATE_CORROBORATION_MIN_CONFIDENCE=0.50
# Two sightings closer together than this are the same glance, not confirmation.
GATE_MIN_FRAME_GAP_SECONDS=90
# Further apart than this and they are probably unrelated events.
GATE_MAX_FRAME_GAP_SECONDS=1800
# If the state's own incident feed already has something this close, stand down.
# The entire point is catching what they missed.
GATE_DUPLICATE_RADIUS_METERS=500
# How far below the filing threshold still earns another look rather than a drop.
GATE_WATCH_MARGIN=0.15


# --- Polling tiers ----------------------------------------------------------

POLL_SECONDS_BUSY=120
POLL_SECONDS_QUIET=600
POLL_SECONDS_ACTIVE=60
AUDITOR_INTERVAL_SECONDS=3600
# Frames within this hash distance are treated as identical and skipped.
# 0 means "only literally identical frames". Do not raise this: frame
# differencing genuinely cannot see a hazard (traffic movement swamps it), so a
# looser threshold silently discards the frames worth analysing.
PHASH_IDENTICAL_THRESHOLD=0
# Safety net. However many identical frames arrive, look properly every this
# many polls regardless -- otherwise a static scene with a hazard in it would
# be skipped forever.
MAX_CONSECUTIVE_SKIPS=10


# --- Dashboard --------------------------------------------------------------

WEB_HOST=127.0.0.1
WEB_PORT=8080
