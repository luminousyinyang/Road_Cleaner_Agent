# ============================================================================
# Road Cleaner configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and edit. Every value below is already the default, so an
# empty .env runs the full pipeline locally with no credentials at all.
#
#   cp .env.example .env
#   make setup && make demo
#
# Nothing in this file is secret in local mode. Once you add real API keys,
# .env is gitignored -- keep it that way, and use Secret Manager in production.
# ============================================================================


# --- Core -------------------------------------------------------------------

# local = fixtures, SQLite, in-memory bus, scripted vision. No credentials.
# cloud = 511 APIs, Firestore, GCS, Pub/Sub, Gemini on Vertex AI.
# Individual settings below override whichever mode you pick.
ROAD_CLEANER_MODE=local

# The anti-spam master switch. While true, reports are fully composed and
# stored but never actually sent to an agency. Turning this off is not enough
# on its own -- filing for real also needs `road-cleaner file --confirm`.
# Leave it true unless you are deliberately filing a real, human-reviewed report.
DRY_RUN=true

LOG_LEVEL=INFO
DATA_DIR=./data


# --- Vision and agent reasoning ---------------------------------------------

# false -> deterministic scripted reasoning, runs with no key.
# true  -> real Google ADK agents driving Gemini. Needs the Vertex settings below.
USE_ADK=false

# auto | scripted | gemini   (auto follows ROAD_CLEANER_MODE)
VISION_PROVIDER=auto

# Checked against Vertex pricing on 2026-08-18. 3.7 Flash is on introductory
# pricing of $0.75/$3.75 per 1M tokens in/out until 2026-12-31, after which it
# doubles to $1.50/$7.50. That is still half what 3.5 Flash costs ($1.50/$9.00),
# so 3.7 is the cheaper choice either side of the new year -- but revisit this
# in December, because the jump is a 2x increase in the vision bill overnight.
GEMINI_MODEL=gemini-3.7-flash

# The cheap first-pass filter: one yes/no question per frame, so the expensive
# model only sees frames that already look anomalous.
#
# Leave this off unless you have actually deployed Gemma. Gemma is not a
# serverless publisher model on Vertex -- a bare name like "gemma-3-4b-it" 404s
# (checked 2026-08-21 for 3-4b-it, 3-27b-it and 3n-e4b-it). To use it you deploy
# it from Model Garden onto a GPU endpoint and put that endpoint's resource name
# here instead:  projects/<project>/locations/<region>/endpoints/<endpoint-id>
# `road-cleaner doctor` flags this if you enable it with a bare name.
GEMMA_PREFILTER_ENABLED=false
GEMMA_MODEL=gemma-3-4b-it

GOOGLE_CLOUD_PROJECT=
# "global" routes to whichever region has capacity and is where the newest
# models land first. Pin a specific region only if you need data residency.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Only used when GOOGLE_GENAI_USE_VERTEXAI=false (Gemini Developer API instead).
GOOGLE_API_KEY=

# Service account key for local runs. Leave empty to use whatever Application
# Default Credentials are already set up (`gcloud auth application-default
# login`), which is also how this runs on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=


# --- Simulation / synthetic media -------------------------------------------

# Turns real detections into synthetic AV training footage: Veo renders a
# dashcam-perspective clip of a hazard we actually found, Chirp narrates the
# dispatch briefing, Lyria scores the reel.
#
# scripted -> replays whatever is already cached in data/media/, no credentials
# vertex   -> really calls Veo/Chirp/Lyria, and really bills for it
#
# Note this does NOT follow ROAD_CLEANER_MODE like the other adapters do. Video
# generation is billed per second, so switching to cloud mode must not silently
# switch it on. Generation only ever runs via `road-cleaner simulate` -- never in
# the polling loop and never on a web request.
MEDIA_PROVIDER=scripted

# Use the GA ids. Every veo-*-generate-preview id now 404s when you actually
# call it, even though a REST GET on the publisher model still returns 200 --
# readable metadata is not the same as callable model. Verified 2026-08-21:
# veo-3.1-generate-001 and veo-3.1-fast-generate-001 work, nothing else does.
VEO_MODEL=veo-3.1-fast-generate-001
LYRIA_MODEL=lyria-002
TTS_VOICE=en-US-Chirp3-HD-Achernar

# Veo and Lyria are region-pinned; both were verified in us-central1 and neither
# is reachable at "global". Kept separate from GOOGLE_CLOUD_LOCATION so Gemini
# can stay on "global" without breaking video.
VERTEX_MEDIA_LOCATION=us-central1

# Generated clips live here -- deliberately NOT data/frames/, which holds real
# camera evidence. Synthetic media never enters the evidence chain of a filed
# report; keeping them in separate directories is what enforces that.
#
# Re-rendering a case replaces its previous clip rather than accumulating one per
# attempt. Only the same kind of media is pruned, so a new video never deletes
# that case's spoken briefing. There is deliberately no equivalent for
# data/frames/: a clip can always be regenerated, and evidence cannot.
MEDIA_LOCAL_PATH=

# A Veo call is a long-running operation, not a request/response. Give up after
# this long rather than hanging a CLI command forever. A 1080p clip takes about
# two minutes, so do not set this much lower.
VEO_TIMEOUT_SECONDS=300

# 720p renders in about half the time; 1080p looks markedly better and is what
# makes the footage read as real dashcam video rather than a game.
VEO_RESOLUTION=1080p

# Cannot actually be turned off -- Veo 3 rejects the request with "Veo 3 prompt
# enhancement cannot be disabled". Left here for the day a model allows it.
# Veo's rewrite is what inflates hazards into dramatic set pieces; the size
# anchors in scenario_prompt.py and the negative prompt are what hold it back.
VEO_ENHANCE_PROMPT=true


# --- Camera sources ---------------------------------------------------------

# auto | fixture | vendor511
# fixture   -> simulated cameras rendering synthetic road scenes
# vendor511 -> the real state DOT APIs (needs the keys below)
CAMERA_SOURCE=auto

# GA, FL and NC all run the same vendor platform:
#   https://<host>/api/v2/get/<resource>?key=<KEY>&format=json
# Each state issues its own free developer key. Register per state:
#   GA -> https://511ga.org  (account, then request a developer key)
#   FL -> https://fl511.com
#   NC -> https://drivenc.gov
# Approval can take days, so request them early.
GA_511_BASE_URL=https://511ga.org
FL_511_BASE_URL=https://fl511.com
NC_511_BASE_URL=https://www.drivenc.gov
GA_511_API_KEY=
FL_511_API_KEY=
NC_511_API_KEY=

# The published throttle on that platform is 10 calls per 60 seconds per key.
# We stay under it client-side rather than relying on being told to back off.
STATE_API_RATE_LIMIT=10
STATE_API_RATE_WINDOW_SECONDS=60


# --- Storage ----------------------------------------------------------------

# auto | sqlite | firestore
REPOSITORY=auto
SQLITE_PATH=./data/road_cleaner.db
FIRESTORE_DATABASE=(default)

# auto | local | gcs        -- where evidence frames live
BLOB_STORE=auto
BLOB_LOCAL_PATH=./data/frames
GCS_BUCKET=


# --- Event bus --------------------------------------------------------------

# auto | memory | pubsub
EVENT_BUS=auto
PUBSUB_TOPIC_FRAMES=frame-captured
PUBSUB_TOPIC_HAZARDS=hazard-confirmed
PUBSUB_TOPIC_DLQ=road-cleaner-dlq


# --- Filing -----------------------------------------------------------------

# auto | dry_run | open311 | email
# Defaults to dry_run in BOTH modes. Going live is always deliberate.
FILING_CHANNEL=auto

# Where dry-run reports get written instead of being sent.
FILING_SANDBOX_INBOX=./data/outbox
FILING_FROM_ADDRESS=road-cleaner@example.invalid

OPEN311_ENDPOINT=
OPEN311_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# --- Confidence gate --------------------------------------------------------
# This is the false-positive defense. It would rather miss a hazard than send
# an agency somebody after a shadow. Loosen these and you will file garbage.

# Below this, a detection is discarded outright.
GATE_MIN_CONFIDENCE=0.55
# A second sighting has to clear this to count as corroboration.
GATE_CORROBORATION_MIN_CONFIDENCE=0.50
# Two sightings closer together than this are the same glance, not confirmation.
GATE_MIN_FRAME_GAP_SECONDS=90
# Further apart than this and they are probably unrelated events.
GATE_MAX_FRAME_GAP_SECONDS=1800
# If the state's own incident feed already has something this close, stand down.
# The entire point is catching what they missed.
GATE_DUPLICATE_RADIUS_METERS=500
# How far below the filing threshold still earns another look rather than a drop.
GATE_WATCH_MARGIN=0.15


# --- Polling tiers ----------------------------------------------------------

POLL_SECONDS_BUSY=120
POLL_SECONDS_QUIET=600
POLL_SECONDS_ACTIVE=60
AUDITOR_INTERVAL_SECONDS=3600
# Frames within this hash distance are treated as identical and skipped.
# 0 means "only literally identical frames". Do not raise this: frame
# differencing genuinely cannot see a hazard (traffic movement swamps it), so a
# looser threshold silently discards the frames worth analysing.
PHASH_IDENTICAL_THRESHOLD=0
# Safety net. However many identical frames arrive, look properly every this
# many polls regardless -- otherwise a static scene with a hazard in it would
# be skipped forever.
MAX_CONSECUTIVE_SKIPS=10


# --- Dashboard --------------------------------------------------------------

WEB_HOST=127.0.0.1
WEB_PORT=8080
